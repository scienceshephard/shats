# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/shats/node_modules
/shats/.pnp
/shats.pnp.*
/shats.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/shats/.next/
/shats/out/

# production
/shats/build

# misc
.DS_Store
*.pem

# debug
/shats/npm-debug.log*
/shats/yarn-debug.log*
/shats/yarn-error.log*
/shats/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/shats/.env*

# vercel
/shats/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
