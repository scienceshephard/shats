# Which mode the app runs in: development or production.
#
#   development  Every screen is reachable without signing in, and every form
#                uses the built-in sample data instead of calling the back end.
#                This is the mode for walking the design end to end.
#
#   production   Role guards in proxy.ts are enforced, and forms call the API
#                gateway configured below.
#
# Leave it unset and it follows the build: `npm run dev` is development, a
# production build is production.
NEXT_PUBLIC_MODE=development

# Point every service at one gateway. Ignored while NEXT_PUBLIC_MODE is
# development — nothing is sent over the network in that mode.
NEXT_PUBLIC_API_GATEWAY=http://localhost:8080

# Override per service once they are split out. Anything left unset falls back
# to NEXT_PUBLIC_API_GATEWAY, so you can migrate one service at a time.
# NEXT_PUBLIC_API_AUTH=http://localhost:8081
# NEXT_PUBLIC_API_PATIENTS=http://localhost:8082
# NEXT_PUBLIC_API_DOCTORS=http://localhost:8083
# NEXT_PUBLIC_API_APPOINTMENTS=http://localhost:8084
# NEXT_PUBLIC_API_CONSULTATIONS=http://localhost:8085
# NEXT_PUBLIC_API_PRESCRIPTIONS=http://localhost:8086
# NEXT_PUBLIC_API_PAYMENTS=http://localhost:8087
# NEXT_PUBLIC_API_EMERGENCY=http://localhost:8088
# NEXT_PUBLIC_API_CHW=http://localhost:8089
# NEXT_PUBLIC_API_CONTENT=http://localhost:8090
# NEXT_PUBLIC_API_NOTIFICATIONS=http://localhost:8091
